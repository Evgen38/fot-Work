Random IP Address
Для тестирования были сгенерированы случайным образом 500 ip адресов из диапазона: 16.0.0.0 - 48.255.255.255

random_ip.py

import requests
import random
import ipaddress
from requests.packages.urllib3.exceptions import InsecureRequestWarning
requests.packages.urllib3.disable_warnings(InsecureRequestWarning)


mgmt_ip = "192.168.100.175"
mgmt_login =  "admin"
mgmt_pass = "..."
obj_num = 500
url = f"https://{mgmt_ip}/api/v2/Login"
possible_transport = ["SERVICE_PROTOCOL_TCP", "SERVICE_PROTOCOL_UDP"]




payload = {
    "login": mgmt_login,
    "password": mgmt_pass
}
headers = {"Content-Type": "application/json"}

response_auth = requests.post(url, json=payload, headers=headers, verify=False)
if response_auth.status_code == 200:
  print("auth ok")
  url =  f"https://{mgmt_ip}/api/v2/GetDeviceGroupsTree"
  r = requests.post(url, headers=headers, verify=False, cookies=response_auth.cookies)
  global_gr_id = r.json()['groups'][0]['id']



ip_range_start = ipaddress.IPv4Address('16.0.0.0')
ip_range_end = ipaddress.IPv4Address('48.255.255.255')
rule_name_masks = ["Source", "Dest"]

def random_service():
  url_serv  = f"https://{mgmt_ip}/api/v2/CreateNetworkObject"

  for rule_name_mask in rule_name_masks:
    for i in range(obj_num):
      random_ip = str(ipaddress.IPv4Address(random.randint(int(ip_range_start), int(ip_range_end))))

      payload_serv = {
          "name": f"{rule_name_mask}_{random_ip.replace('.', '_')}",
          "deviceGroupId": global_gr_id,
          "description": "",
          "value": {
          "inet": {
              "inet": f"{random_ip}/32"
          }
      }

      }
      #print(payload_serv)
      headers = {"Content-Type": "application/json"}
      response_ser = requests.post(url_serv, json=payload_serv, headers=headers, verify=False, cookies=response_auth.cookies)
      print(f"{random_ip}: {response_ser.json()}")



random_service()

Random Rules
Для тестирования были сгенерированы случайным образом 1000 правил

random_rules.py
import requests
import random
import ipaddress
from requests.packages.urllib3.exceptions import InsecureRequestWarning
requests.packages.urllib3.disable_warnings(InsecureRequestWarning)


mgmt_ip = "192.168.100.175"
mgmt_login =  "admin"
mgmt_pass = "..."
obj_num = 1000
url = f"https://{mgmt_ip}/api/v2/Login"
possible_transport = ["SERVICE_PROTOCOL_TCP", "SERVICE_PROTOCOL_UDP"]




payload = {
    "login": mgmt_login,
    "password": mgmt_pass
}
headers = {"Content-Type": "application/json"}

response_auth = requests.post(url, json=payload, headers=headers, verify=False)
if response_auth.status_code == 200:
  print("auth ok")
  url =  f"https://{mgmt_ip}/api/v2/GetDeviceGroupsTree"
  r = requests.post(url, headers=headers, verify=False, cookies=response_auth.cookies)
  global_gr_id = r.json()['groups'][0]['id']




# ---------------------  GET IP ----------------------
url = f"https://{mgmt_ip}:443/api/v2/ListNetworkObjects"



payload = {
    "deviceGroupId": global_gr_id,
    "objectKinds": ["OBJECT_NETWORK_KIND_IPV4_ADDRESS"],
    "offset": 0,
    "limit": 10000
}

response = requests.request("POST", url, json=payload, headers=headers, cookies=response_auth.cookies, verify=False)

if response.status_code == 200:
    data = response.json()
    #print(data)
    dest_objects = [obj["id"] for obj in data["addresses"] if obj["name"].startswith("Dest")]
    src_objects = [obj["id"] for obj in data["addresses"] if obj["name"].startswith("Source")]
else:
    print(f"Error: {response.status_code} - {response.text}")


# ---------------------  GET SERVICE ----------------------
url = f"https://{mgmt_ip}:443/api/v2/ListServices"

payload = {
    "deviceGroupId": global_gr_id,
   
    "objectOriginKinds": ["OBJECT_ORIGIN_KIND_CUSTOM"],
    "offset": 0,
    "limit": 10000
}

response = requests.request("POST", url, json=payload,  headers=headers, cookies=response_auth.cookies, verify=False)

if response.status_code == 200:
    data = response.json()
    id_dict_services = [obj["id"] for obj in data["services"]]
else:
    print(f"Error: {response.status_code} - {response.text}")


# ---------------------  GET ZONES ----------------------

url = f"https://{mgmt_ip}:443/api/v2/ListZones"

payload = {
    "offset": 0,
    "limit": 10000
}

response = requests.request("POST", url, json=payload,  headers=headers, cookies=response_auth.cookies, verify=False)

if response.status_code == 200:
    data = response.json()
    zones = [item["id"] for item in data["zones"] if not item["name"].startswith("Local")]
    #print(zones)
else:
    print(f"Error: {response.status_code} - {response.text}")


possible_action = ["SECURITY_RULE_ACTION_DROP", "SECURITY_RULE_ACTION_ALLOW", "SECURITY_RULE_ACTION_DENY","SECURITY_RULE_ACTION_RESET_SERVER","SECURITY_RULE_ACTION_RESET_CLIENT","SECURITY_RULE_ACTION_RESET_BOTH"]
possible_log = ["SECURITY_RULE_LOG_MODE_NO_LOG", "SECURITY_RULE_LOG_MODE_AT_SESSION_START", "SECURITY_RULE_LOG_MODE_AT_SESSION_END", "SECURITY_RULE_LOG_MODE_AT_RULE_HIT", "SECURITY_RULE_LOG_MODE_AT_SESSION_START_AND_END"]




def random_rules():
  #----------add rules ----------- 
  url_serv  = f"https://{mgmt_ip}/api/v2/CreateSecurityRule"

  for i in range(obj_num):
    random_id_dict_services = random.choice(id_dict_services)
    random_dest_objects = random.choice(dest_objects)
    random_src_objects = random.choice(src_objects)
    random_action = random.choice(possible_action)
    random_log = random.choice(possible_log)
    random_zone_src = random.choice(zones)
    random_zone_dst = random.choice(zones)
    payload = {
    "deviceGroupId": global_gr_id,
    "precedence": "pre",
    "position": i + 1,
    "enabled": True,
    "name": f"Random_Rule_{i}",
    "description": "",
    "sourceZone": {
        "kind": "RULE_KIND_LIST",
        "objects": {
            "array": [
                random_zone_src
            ]
        }
    },
    "destinationZone": {
        "kind": "RULE_KIND_LIST",
        "objects": {
            "array": [
                random_zone_dst
            ]
        }
    },
    "sourceAddr": {
        "kind": "RULE_KIND_LIST",
        "objects": {
            "array": [
                random_src_objects
            ]
        }
    },
    "destinationAddr": {
        "kind": "RULE_KIND_LIST",
        "objects": {
            "array": [
                random_dest_objects
            ]
        }
    },
    "sourceUser": {
        "kind": "RULE_USER_KIND_ANY",
        "objects": {}
    },
    "service": {
        "kind": "RULE_KIND_LIST",
        "objects": {
            "array": [
                random_id_dict_services
            ]
        }
    },
    "application": {
        "kind": "RULE_KIND_ANY",
        "objects": {}
    },
    "urlCategory": {
        "kind": "RULE_KIND_ANY",
        "objects": {}
    },
    "action": random_action,
    "logMode": random_log
    }
    
    
    headers = {"Content-Type": "application/json"}
    response_ser = requests.post(url_serv, json=payload, headers=headers, verify=False, cookies=response_auth.cookies)
    print(f"Random_Rule_{i}: {response_ser.json()}")



random_rules()


Max New Connections per Second:
./trex_run.py -f ./trex_profiles/http_max_cps.py --drp 0.105 -d 600 -t ramp_up=100 response_size_kb=1 -m 100000


Параметры
--drp 0.105:

--drp (Dynamic Rate Percentage) — это параметр, который определяет, какую часть от максимальной пропускной способности будет использовать тест. В данном случае, используется 10.5% от максимальной пропускной способности.

-d 600:

-d указывает продолжительность теста в секундах. В данном случае, тест будет длиться 600 секунд (10 минут).

-t ramp_up=100 response_size_kb=1:

-t позволяет передать дополнительные параметры для теста.

ramp_up=100 — это время (в секундах), за которое тест будет постепенно увеличивать нагрузку до максимального значения.

response_size_kb=1 — это размер HTTP-ответа в килобайтах. В данном случае, размер ответа составляет 1 КБ.

-m 100000:

-m указывает максимальное количество соединений в секунду (CPS), которое будет пытаться достичь тест. В данном случае, это 100 000 соединений в секунду.

Эта команда запускает тест производительности, который:

Использует HTTP-профиль для генерации трафика.

Ограничивает использование пропускной способности до 10.5%.

Длится 10 минут.

Постепенно увеличивает нагрузку в течение 100 секунд.

Использует HTTP-ответы размером 1 КБ.

Пытается достичь 100 000 соединений в секунду.

Этот тест полезен для оценки того, как система справляется с высокой нагрузкой и как быстро она может обрабатывать большое количество соединений.


http_max_cps.py


from trex.astf.api import *
import argparse


http_req = 'GET /index.html HTTP/1.1\r\n' \
           'Host: 22.0.0.3\r\n' \
           'Connection: Close\r\n' \
           'User-Agent: Mozilla/4.0 (compatible; MSIE 7.0; Windows NT 5.1; SV1; .NET CLR 1.1.4322; .NET CLR 2.0.50727)\r\n' \
           'Accept: */*\r\n' \
           'Accept-Language: en-us\r\n' \
           'Accept-Encoding: gzip, deflate, compress\r\n' \
           '\r\n'

http_response_headers = 'HTTP/1.1 200 OK\r\n' \
                         'Server: Microsoft-IIS/6.0\r\n' \
                         'Content-Type: text/html\r\n' \
                         'Content-Length: {0}\r\n' \
                         '\r\n'

http_response_body = '<html><pre>{0}</pre></html>'

RESPONSE_BODY_TAGS_BYTES = 24


class Prof1():
    def __init__(self):
        pass  # tunables

    def create_profile(self, resp_body_size, delay, ramp_up):
        if resp_body_size > 24:
            http_response = http_response_headers.format(resp_body_size) + \
                            http_response_body.format('*' * (resp_body_size - RESPONSE_BODY_TAGS_BYTES))
        else:
            http_response = http_response_headers.format(resp_body_size) + '*' * resp_body_size
        # client commands
        prog_c = ASTFProgram()
        prog_c.send(http_req)
        prog_c.recv(len(http_response))
        # implicit  close

        # server commands
        prog_s = ASTFProgram()
        prog_s.recv(len(http_req))
        if delay: prog_s.delay(delay)
        prog_s.send(http_response)
        prog_s.wait_for_peer_close()

        # ip generator
        ip_gen_c = ASTFIPGenDist(ip_range=["16.0.0.1", "16.0.255.199"], distribution="rand")
        ip_gen_s = ASTFIPGenDist(ip_range=["48.0.0.1", "48.1.255.199"], distribution="rand")
        ip_gen = ASTFIPGen(glob=ASTFIPGenGlobal(ip_offset="1.0.0.0"),
                           dist_client=ip_gen_c,
                           dist_server=ip_gen_s)

        # template
        temp_c = ASTFTCPClientTemplate(program=prog_c, ip_gen=ip_gen)
        temp_s = ASTFTCPServerTemplate(program=prog_s)  # using default association
        template = ASTFTemplate(client_template=temp_c, server_template=temp_s)

        # Set rx/tx buffer to 64K. TCP window size also will be 64K
        c_glob_info = ASTFGlobalInfo()
        c_glob_info.tcp.rxbufsize = 65535
        c_glob_info.tcp.txbufsize = 65535
        if ramp_up: c_glob_info.scheduler.rampup_sec = ramp_up
        s_glob_info = ASTFGlobalInfo()
        s_glob_info.tcp.rxbufsize = 65535
        s_glob_info.tcp.txbufsize = 65535

        # profile
        profile = ASTFProfile(default_ip_gen=ip_gen,
                              default_c_glob_info=c_glob_info,
                              default_s_glob_info=s_glob_info,
                              templates=template)
        return profile

    def get_profile(self, tunables, **kwargs):
        parser = argparse.ArgumentParser(description='Argparser for {}'.format(os.path.basename(__file__)), 
                                         formatter_class=argparse.ArgumentDefaultsHelpFormatter)
        parser.add_argument('--response_size_kb',
                            type=float,
                            default=1,
                            help='The response size in KB')
        parser.add_argument('--delay',
                            type=int,
                            default=None,
                            help='Server response delay (usec)')
        parser.add_argument('--ramp_up',
                            type=int,
                            default=0,
                            help='Ramp up period (sec)')
        args, unknown = parser.parse_known_args(tunables)
        if unknown:
            raise Exception('unrecognized arguments {0}\n{1}'.format(unknown, parser.format_usage()))
        resp_size = int(args.response_size_kb * 1024)
        return self.create_profile(resp_size, args.delay, args.ramp_up)


def register():
    return Prof1()
FW


2. Max Concurrent connections:
./trex_run.py -f ./trex_profiles/max_сс.py --drp 0.105 -t flow_size=20 delay=31.18 -d 23.54 -m 100000 --cc-dur 600

Параметры
--drp 0.105:

--drp (Dynamic Rate Percentage) — это параметр, который определяет, какую часть от максимальной пропускной способности будет использовать тест. В данном случае, используется 10.5% от максимальной пропускной способности.

-t flow_size=20 delay=31.18:

-t позволяет передать дополнительные параметры для теста.

flow_size=20 — это размер потока данных (в пакетах), который будет использоваться для каждого соединения.

delay=31.18 — это задержка (в миллисекундах) между пакетами в каждом потоке.

-d 23.54:

-d указывает продолжительность теста в секундах. В данном случае, тест будет длиться 23.54 секунды.

-m 100000:

-m указывает максимальное количество соединений, которое будет пытаться достичь тест. В данном случае, это 100 000 одновременных соединений.

--cc-dur 600:

--cc-dur (Concurrent Connections Duration) — это параметр, который определяет, как долго (в секундах) тест будет поддерживать максимальное количество одновременных соединений. В данном случае, это 600 секунд (10 минут).

Эта команда запускает тест производительности, который:

Использует профиль для измерения максимального количества одновременных соединений.

Ограничивает использование пропускной способности до 10.5%.

Использует потоки данных размером 20 пакетов с задержкой 31.18 мс между пакетами.

Длится 23.54 секунды.

Пытается достичь 100 000 одновременных соединений.

Поддерживает максимальное количество соединений в течение 600 секунд (10 минут).

Этот тест полезен для оценки того, как система справляется с большим количеством одновременных соединений и как долго она может поддерживать такую нагрузку.


max_сс.py


from trex.astf.api import *
import argparse


class Prof1():
    def __init__(self):
        self.p1_src_start_ip = '16.0.0.1'
        self.p1_src_end_ip = '16.0.255.199'

        self.p1_dst_start_ip = '48.0.0.1'
        self.p1_dst_end_ip = '48.1.255.199'

        self.http_req = ('GET /index.html HTTP/1.1\r\n' \
                         'Host: {host}\r\n' \
                         'Connection: Keep-Alive\r\n' \
                         'User-Agent: Mozilla/4.0 (compatible; MSIE 7.0; Windows NT 5.1; SV1; .NET CLR 1.1.4322; .NET CLR 2.0.50727)\r\n' \
                         'Accept: */*\r\n' \
                         'Accept-Language: en-us\r\n' \
                         'Accept-Encoding: gzip, deflate, compress\r\n' \
                         '\r\n'
                         .format(host=self.p1_dst_start_ip))

        self.http_response_template = 'HTTP/1.1 200 OK\r\n' \
                                      'Server: Microsoft-IIS/6.0\r\n' \
                                      'Content-Type: text/html\r\n' \
                                      'Content-Length: {0}\r\n' \
                                      '\r\n' \
                                      '<html><pre>{1}</pre></html>'

        self.response_body_tags_bytes = 24


    def create_profile(self, resp_size, delay, flow_size):

        http_response = self.http_response_template.format(resp_size, '*' * ( resp_size - self.response_body_tags_bytes ))
        # client commands
        prog_c = ASTFProgram()
        prog_c.set_var("i", flow_size)
        prog_c.set_label("a:")
        prog_c.send(self.http_req)
        prog_c.recv(len(http_response))
        # Delay in usec
        prog_c.delay(delay)
        prog_c.jmp_nz("i", "a:")
        # implicit  close

        # server commands
        prog_s = ASTFProgram()
        prog_s.set_var("i", flow_size)
        prog_s.set_label("a:")
        prog_s.recv(len(self.http_req))
        prog_s.send(http_response)
        prog_s.jmp_nz("i", "a:")
        prog_s.wait_for_peer_close()

        # ip generator
        ip_gen_c = ASTFIPGenDist(ip_range=[self.p1_src_start_ip, self.p1_src_end_ip], distribution="seq")
        ip_gen_s = ASTFIPGenDist(ip_range=[self.p1_dst_start_ip, self.p1_dst_end_ip], distribution="seq")
        ip_gen = ASTFIPGen(glob=ASTFIPGenGlobal(ip_offset="1.0.0.0"),
                           dist_client=ip_gen_c,
                           dist_server=ip_gen_s)

        # template
        temp_c = ASTFTCPClientTemplate(program=prog_c, ip_gen=ip_gen, limit=60000000)
        temp_s = ASTFTCPServerTemplate(program=prog_s)  # using default association
        template = ASTFTemplate(client_template=temp_c, server_template=temp_s)

        # Set rx/tx buffer to 64K. TCP window size also will be 64K
        c_glob_info = ASTFGlobalInfo()
        c_glob_info.tcp.rxbufsize = 65535
        c_glob_info.tcp.txbufsize = 65535

        ## Increase tcp timeouts 
        c_glob_info.tcp.keepinit = 5000
        c_glob_info.tcp.keepidle = 5000
        c_glob_info.tcp.keepintvl = 5000
        c_glob_info.tcp.delay_ack_msec = 4000
        
        s_glob_info = ASTFGlobalInfo()
        s_glob_info.tcp.rxbufsize = 65535
        s_glob_info.tcp.txbufsize = 65535

        ## Increase tcp timeouts 
        s_glob_info.tcp.keepinit = 5000
        s_glob_info.tcp.keepidle = 5000
        s_glob_info.tcp.keepintvl = 5000
        s_glob_info.tcp.delay_ack_msec = 4000

        # profile
        return ASTFProfile(default_ip_gen=ip_gen,
                           default_c_glob_info=c_glob_info,
                           default_s_glob_info=s_glob_info,
                           templates=template)

    def get_profile(self, tunables, **kwargs):
        parser = argparse.ArgumentParser(description='Argparser for {}'.format(os.path.basename(__file__)), 
                                         formatter_class=argparse.ArgumentDefaultsHelpFormatter)
        parser.add_argument('--response_size_kb',
                            type=int,
                            default=1,
                            help='The response size in KB')
        parser.add_argument('--delay',
                            type=float,
                            default=30,
                            help='Delay between transactions in sec')
        parser.add_argument('--flow_size',
                            type=int,
                            default=10,
                            help='Flow size (transactions)')
        args, unknown = parser.parse_known_args(tunables)
        if unknown:
            raise Exception('unrecognized arguments {0}\n{1}'.format(unknown, parser.format_usage()))
        resp_size = args.response_size_kb * 1024
        delay = int(args.delay * 1_000_000)
        return self.create_profile(resp_size, delay, args.flow_size)


def register():
    return Prof1()
3. Max throughput (UDP) 64B:
./trex_run.py -f ./trex_profiles/udp_imix.py --drp 0.105 -d 600 -t ramp_up=100 flow_size=1000 frame_size_b=64 -m 1000

Параметры
Эта команда запускает тест производительности, который:

Использует UDP-профиль с IMIX для генерации трафика.

Ограничивает использование пропускной способности до 10.5%.

Длится 10 минут.

Постепенно увеличивает нагрузку в течение 100 секунд.

Использует UDP-пакеты размером 64 байта.

Пытается достичь пропускной способности 1000 Mbps.

Этот тест полезен для оценки того, как система справляется с высокой пропускной способностью UDP-трафика, особенно с небольшими пакетами (64 байта), что часто используется для тестирования производительности сетевого оборудования.




from trex.astf.api import *
import argparse

UDP_REQ_BASE = 'x'
UDP_RESP_BASE = 'y'
FCS = 4
ETHER_HEADER = 14
IP_HEADER = 20
UDP_HEADER = 8
FRAME_HEADERS = FCS + ETHER_HEADER + IP_HEADER + UDP_HEADER


class Prof1():
    def __init__(self):
        pass  # tunables

    def create_profile(self, ramp_up, frame_size, delay, flow_size):

        # client commands
        udp_req = UDP_REQ_BASE * (frame_size - FRAME_HEADERS)
        prog_c = ASTFProgram(stream=False)
        for i in range(0, int(flow_size / 2)):
            prog_c.send_msg(udp_req)
            prog_c.recv_msg(1)

        udp_resp = UDP_RESP_BASE * (frame_size - FRAME_HEADERS)
        prog_s = ASTFProgram(stream=False)
        for i in range(0, int(flow_size / 2)):
            prog_s.recv_msg(1)
            if delay: prog_s.delay(delay)
            prog_s.send_msg(udp_resp)

        # ip generator
        ip_gen_c = ASTFIPGenDist(ip_range=["16.0.0.1", "16.0.255.199"], distribution="rand")
        ip_gen_s = ASTFIPGenDist(ip_range=["48.0.0.1", "48.1.255.199"], distribution="rand")
        ip_gen = ASTFIPGen(glob=ASTFIPGenGlobal(ip_offset="1.0.0.0"),
                           dist_client=ip_gen_c,
                           dist_server=ip_gen_s)

        # template
        assoc = ASTFAssociationRule(port=53)
        temp_c = ASTFTCPClientTemplate(program=prog_c, ip_gen=ip_gen, port=53)
        temp_s = ASTFTCPServerTemplate(program=prog_s, assoc=assoc)
        template = ASTFTemplate(client_template=temp_c, server_template=temp_s)
        # Set rx/tx buffer
        c_glob_info = ASTFGlobalInfo()
        c_glob_info.tcp.rxbufsize = 1000000
        c_glob_info.tcp.txbufsize = 1000000
        if ramp_up: c_glob_info.scheduler.rampup_sec = ramp_up
        s_glob_info = ASTFGlobalInfo()
        s_glob_info.tcp.rxbufsize = 1000000
        s_glob_info.tcp.txbufsize = 1000000
        # profile
        profile = ASTFProfile(default_ip_gen=ip_gen,
                              default_c_glob_info=c_glob_info,
                              default_s_glob_info=s_glob_info,
                              templates=template)
        return profile

    def get_profile(self, tunables, **kwargs):
        parser = argparse.ArgumentParser(description='Argparser for {}'.format(os.path.basename(__file__)),
                                         formatter_class=argparse.ArgumentDefaultsHelpFormatter)
        parser.add_argument('--frame_size_b',
                            type=int,
                            default=64,
                            help='Frame size with FCS, bytes')
        parser.add_argument('--delay',
                            type=int,
                            default=None,
                            help='Server response delay (usec)')
        parser.add_argument('--flow_size',
                            type=int,
                            default=2,
                            help='Flow size (packets)')
        parser.add_argument('--ramp_up',
                            type=int,
                            default=0,
                            help='Ramp up period (sec)')
        args, unknown = parser.parse_known_args(tunables)
        if unknown:
            raise Exception('unrecognized arguments {0}\n{1}'.format(unknown, parser.format_usage()))
        return self.create_profile(args.ramp_up, args.frame_size_b, args.delay, args.flow_size)


def register():
    return Prof1()

4. Max throughput (UDP) 1518B:
./trex_run.py -f ./trex_profiles/udp_imix.py --drp 0.105 -d 600 -t ramp_up=100 flow_size=1000 frame_size_b=1518 -m 1000

Параметры
Эта команда запускает тест производительности, который:

Использует UDP-профиль с IMIX для генерации трафика.

Ограничивает использование пропускной способности до 10.5%.

Длится 10 минут.

Постепенно увеличивает нагрузку в течение 100 секунд.

Использует UDP-пакеты размером 1518 байт (максимальный размер для Ethernet MTU).

Пытается достичь пропускной способности 1000 Mbps.

Этот тест полезен для оценки того, как система справляется с высокой пропускной способностью UDP-трафика, особенно с большими пакетами (1518 байт), что часто используется для тестирования производительности сетевого оборудования на максимальной нагрузке.



udp_imix.py


from trex.astf.api import *
import argparse

UDP_REQ_BASE = 'x'
UDP_RESP_BASE = 'y'
FCS = 4
ETHER_HEADER = 14
IP_HEADER = 20
UDP_HEADER = 8
FRAME_HEADERS = FCS + ETHER_HEADER + IP_HEADER + UDP_HEADER


class Prof1():
    def __init__(self):
        pass  # tunables

    def create_profile(self, ramp_up, frame_size, delay, flow_size):

        # client commands
        udp_req = UDP_REQ_BASE * (frame_size - FRAME_HEADERS)
        prog_c = ASTFProgram(stream=False)
        for i in range(0, int(flow_size / 2)):
            prog_c.send_msg(udp_req)
            prog_c.recv_msg(1)

        udp_resp = UDP_RESP_BASE * (frame_size - FRAME_HEADERS)
        prog_s = ASTFProgram(stream=False)
        for i in range(0, int(flow_size / 2)):
            prog_s.recv_msg(1)
            if delay: prog_s.delay(delay)
            prog_s.send_msg(udp_resp)

        # ip generator
        ip_gen_c = ASTFIPGenDist(ip_range=["16.0.0.1", "16.0.255.199"], distribution="rand")
        ip_gen_s = ASTFIPGenDist(ip_range=["48.0.0.1", "48.1.255.199"], distribution="rand")
        ip_gen = ASTFIPGen(glob=ASTFIPGenGlobal(ip_offset="1.0.0.0"),
                           dist_client=ip_gen_c,
                           dist_server=ip_gen_s)

        # template
        assoc = ASTFAssociationRule(port=53)
        temp_c = ASTFTCPClientTemplate(program=prog_c, ip_gen=ip_gen, port=53)
        temp_s = ASTFTCPServerTemplate(program=prog_s, assoc=assoc)
        template = ASTFTemplate(client_template=temp_c, server_template=temp_s)
        # Set rx/tx buffer
        c_glob_info = ASTFGlobalInfo()
        c_glob_info.tcp.rxbufsize = 1000000
        c_glob_info.tcp.txbufsize = 1000000
        if ramp_up: c_glob_info.scheduler.rampup_sec = ramp_up
        s_glob_info = ASTFGlobalInfo()
        s_glob_info.tcp.rxbufsize = 1000000
        s_glob_info.tcp.txbufsize = 1000000
        # profile
        profile = ASTFProfile(default_ip_gen=ip_gen,
                              default_c_glob_info=c_glob_info,
                              default_s_glob_info=s_glob_info,
                              templates=template)
        return profile

    def get_profile(self, tunables, **kwargs):
        parser = argparse.ArgumentParser(description='Argparser for {}'.format(os.path.basename(__file__)),
                                         formatter_class=argparse.ArgumentDefaultsHelpFormatter)
        parser.add_argument('--frame_size_b',
                            type=int,
                            default=64,
                            help='Frame size with FCS, bytes')
        parser.add_argument('--delay',
                            type=int,
                            default=None,
                            help='Server response delay (usec)')
        parser.add_argument('--flow_size',
                            type=int,
                            default=2,
                            help='Flow size (packets)')
        parser.add_argument('--ramp_up',
                            type=int,
                            default=0,
                            help='Ramp up period (sec)')
        args, unknown = parser.parse_known_args(tunables)
        if unknown:
            raise Exception('unrecognized arguments {0}\n{1}'.format(unknown, parser.format_usage()))
        return self.create_profile(args.ramp_up, args.frame_size_b, args.delay, args.flow_size)


def register():
    return Prof1()


5. Max throughput (TCP, HTTP, 64KB):  
./trex_run.py -f ./trex_profiles/tcp_http_64KB.py --drp 0.105 -d 600 -t ramp_up=100 flow_size=10 -m 300

Параметры
Эта команда запускает тест производительности, который:

Использует TCP-профиль с HTTP и размером данных 64 КБ для генерации трафика.

Ограничивает использование пропускной способности до 10.5%.

Длится 10 минут.

Постепенно увеличивает нагрузку в течение 100 секунд.

Использует 10 потоков (flows) для генерации трафика.

Пытается достичь пропускной способности 300 Mbps.

Этот тест полезен для оценки того, как система справляется с высокой пропускной способностью TCP-трафика, особенно при использовании HTTP с большими объемами данных (64 КБ). Это может быть полезно для тестирования производительности веб-серверов, прокси-серверов или других сетевых устройств, обрабатывающих HTTP-трафик.



             
             
.

tcp_http_64KB.py


from trex.astf.api import *
import argparse


class Prof1():
    def __init__(self):
        self.p1_src_start_ip = '16.0.0.1'
        self.p1_src_end_ip = '16.0.255.199'

        self.p1_dst_start_ip = '48.0.0.1'
        self.p1_dst_end_ip = '48.1.255.199'

        self.http_req = ('GET /index.html HTTP/1.1\r\n' \
                         'Host: {host}\r\n' \
                         'Connection: Keep-Alive\r\n' \
                         'User-Agent: Mozilla/4.0 (compatible; MSIE 7.0; Windows NT 5.1; SV1; .NET CLR 1.1.4322; .NET CLR 2.0.50727)\r\n' \
                         'Accept: */*\r\n' \
                         'Accept-Language: en-us\r\n' \
                         'Accept-Encoding: gzip, deflate, compress\r\n' \
                         '\r\n'
                         .format(host=self.p1_dst_start_ip))

        self.http_response_template = 'HTTP/1.1 200 OK\r\n' \
                                      'Server: Microsoft-IIS/6.0\r\n' \
                                      'Content-Type: text/html\r\n' \
                                      'Content-Length: {0}\r\n' \
                                      '\r\n' \
                                      '<html><pre>{1}</pre></html>'

        self.response_body_tags_bytes = 24


    def create_profile(self, resp_size, delay, flow_size, ramp_up):

        http_response = self.http_response_template.format(resp_size, '*' * ( resp_size - self.response_body_tags_bytes ))
        # client commands
        prog_c = ASTFProgram()
        prog_c.set_var("i", flow_size)
        prog_c.set_label("a:")
        prog_c.send(self.http_req)
        prog_c.recv(len(http_response))
        prog_c.jmp_nz("i", "a:")
        # implicit  close

        # server commands
        prog_s = ASTFProgram()
        prog_s.set_var("i", flow_size)
        prog_s.set_label("a:")
        prog_s.recv(len(self.http_req))
        if delay: prog_s.delay(delay)
        prog_s.send(http_response)
        prog_s.jmp_nz("i", "a:")
        prog_s.wait_for_peer_close()

        # ip generator
        ip_gen_c = ASTFIPGenDist(ip_range=[self.p1_src_start_ip, self.p1_src_end_ip], distribution="rand")
        ip_gen_s = ASTFIPGenDist(ip_range=[self.p1_dst_start_ip, self.p1_dst_end_ip], distribution="rand")
        ip_gen = ASTFIPGen(glob=ASTFIPGenGlobal(ip_offset="1.0.0.0"),
                           dist_client=ip_gen_c,
                           dist_server=ip_gen_s)

        # template
        temp_c = ASTFTCPClientTemplate(program=prog_c, ip_gen=ip_gen)
        temp_s = ASTFTCPServerTemplate(program=prog_s)  # using default association
        template = ASTFTemplate(client_template=temp_c, server_template=temp_s)

        # Set rx/tx buffer to 64K. TCP window size also will be 64K
        c_glob_info = ASTFGlobalInfo()
        c_glob_info.tcp.rxbufsize = 65535
        c_glob_info.tcp.txbufsize = 65535
        if ramp_up: c_glob_info.scheduler.rampup_sec = ramp_up
        s_glob_info = ASTFGlobalInfo()
        s_glob_info.tcp.rxbufsize = 65535
        s_glob_info.tcp.txbufsize = 65535

        # profile
        return ASTFProfile(default_ip_gen=ip_gen,
                           default_c_glob_info=c_glob_info,
                           default_s_glob_info=s_glob_info,
                           templates=template)

    def get_profile(self, tunables, **kwargs):
        parser = argparse.ArgumentParser(description='Argparser for {}'.format(os.path.basename(__file__)), 
                                         formatter_class=argparse.ArgumentDefaultsHelpFormatter)
        parser.add_argument('--response_size_kb',
                            type=int,
                            default=64,
                            help='The response size in KB')
        parser.add_argument('--delay',
                            type=int,
                            default=None,
                            help='Server response delay (usec)')
        parser.add_argument('--flow_size',
                            type=int,
                            default=10,
                            help='Flow size (transactions)')
        parser.add_argument('--ramp_up',
                            type=int,
                            default=0,
                            help='Ramp up period (sec)')
        args, unknown = parser.parse_known_args(tunables)
        if unknown:
            raise Exception('unrecognized arguments {0}\n{1}'.format(unknown, parser.format_usage()))
        resp_size = args.response_size_kb * 1024
        return self.create_profile(resp_size, args.delay, args.flow_size, args.ramp_up)


def register():
    return Prof1()
             
             
